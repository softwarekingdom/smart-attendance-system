// =====================================
// LOAD TODAY ATTENDANCE
// =====================================

async function loadTodayAttendance() {

    if (!checkSupabase()) {

        return;

    }


    const presentBox =
        document.getElementById("presentStudents");

    const absentBox =
        document.getElementById("absentStudents");

    const rateBox =
        document.getElementById("attendanceRate");

    const reportPresent =
        document.getElementById("reportPresent");

    const reportAbsent =
        document.getElementById("reportAbsent");

    const reportRate =
        document.getElementById("reportRate");

    const summaryBox =
        document.getElementById("aiSummary");

    const predictionBox =
        document.getElementById("prediction");

    const riskBox =
        document.getElementById("riskStudents");


    try {

        // =================================
        // TODAY
        // =================================

        const today =
            new Date()
                .toISOString()
                .split("T")[0];


        console.log(
            "📅 Dashboard Date:",
            today
        );


        // =================================
        // GET ATTENDANCE
        // =================================

        const {
            data: attendance,
            error
        } =
            await supabaseClient
                .from("attendance")
                .select("*")
                .eq("date", today);


        if (error) {

            console.error(
                "Attendance Error:",
                error
            );

            return;

        }


        const records =
            attendance || [];


        // =================================
        // COUNT PRESENT / ABSENT
        // =================================

        let present = 0;

        let absent = 0;


        records.forEach(function (record) {

            if (
                String(record.status)
                    .toLowerCase() ===
                "present"
            ) {

                present++;

            }


            if (
                String(record.status)
                    .toLowerCase() ===
                "absent"
            ) {

                absent++;

            }

        });


        // =================================
        // TOTAL STUDENTS
        // =================================

        const {
            count: totalStudents,
            error: studentError
        } =
            await supabaseClient
                .from("students")
                .select(
                    "id",
                    {
                        count: "exact",
                        head: true
                    }
                );


        if (studentError) {

            console.error(
                "Student Count Error:",
                studentError
            );

            return;

        }


        const total =
            totalStudents || 0;


        // =================================
        // ATTENDANCE RATE
        // =================================

        let rate = 0;


        if (total > 0) {

            rate =
                Math.round(
                    (present / total) * 100
                );

        }


        // =================================
        // UPDATE DASHBOARD
        // =================================

        if (presentBox) {

            presentBox.innerText =
                present;

        }


        if (absentBox) {

            absentBox.innerText =
                absent;

        }


        if (rateBox) {

            rateBox.innerText =
                rate + "%";

        }


        // =================================
        // UPDATE AI REPORT
        // =================================

        if (reportPresent) {

            reportPresent.innerText =
                present;

        }


        if (reportAbsent) {

            reportAbsent.innerText =
                absent;

        }


        if (reportRate) {

            reportRate.innerText =
                rate + "%";

        }


        // =================================
        // RISK STUDENTS
        // =================================

        if (riskBox) {

            riskBox.innerText =
                absent;

        }


        // =================================
        // AI SUMMARY
        // =================================

        let summary;


        if (total === 0) {

            summary =
                "No student data available.";

        }

        else if (records.length === 0) {

            summary =
                "📊 Attendance has not been recorded today.";

        }

        else if (rate >= 90) {

            summary =
                "🟢 Excellent attendance today. " +
                "Students are maintaining a very high attendance level.";

        }

        else if (rate >= 75) {

            summary =
                "🟡 Good attendance today. " +
                "However, some absent students should be monitored.";

        }

        else {

            summary =
                "🔴 Attendance is low today. " +
                "Immediate attention is recommended for absent students.";

        }


        if (summaryBox) {

            summaryBox.innerText =
                summary;

        }


        // =================================
        // AI PREDICTION
        // =================================

        let prediction;


        if (total === 0) {

            prediction =
                "No student data available for prediction.";

        }

        else if (rate >= 90) {

            prediction =
                "🤖 AI predicts excellent attendance tomorrow.";

        }

        else if (rate >= 75) {

            prediction =
                "🤖 AI predicts stable attendance tomorrow.";

        }

        else {

            prediction =
                "⚠️ AI predicts a possible low-attendance risk tomorrow.";

        }


        if (predictionBox) {

            predictionBox.innerText =
                prediction;

        }


        console.log(
            "✅ Attendance Analytics Loaded",
            {
                total,
                present,
                absent,
                rate
            }
        );

    }


    catch (error) {

        console.error(
            "Unexpected Attendance Error:",
            error
        );

    }

}
