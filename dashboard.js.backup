// AI SCHOOL
// Dashboard System
// Supabase Version 1.0
// PART 9
// Today's Attendance Analytics
// =====================================


// =====================================
// LOAD TODAY'S ATTENDANCE
// =====================================

async function loadTodayAttendance() {

    console.log("📊 Part 9: Loading Today's Attendance...");


    // =================================
    // CHECK SUPABASE
    // =================================

    if (!checkSupabase()) {

        console.error(
            "❌ Supabase connection not available."
        );

        return;

    }


    // =================================
    // GET CURRENT USER
    // =================================

    const currentUserData =
        localStorage.getItem("currentUser");


    if (!currentUserData) {

        console.warn(
            "⚠️ No logged-in user."
        );

        return;

    }


    let currentUser;


    try {

        currentUser =
            JSON.parse(currentUserData);

    }
    catch (error) {

        console.error(
            "❌ Current User JSON Error:",
            error
        );

        return;

    }


    // =================================
    // TODAY
    // =================================

    const today =
        new Date()
            .toISOString()
            .split("T")[0];


    console.log(
        "📅 Today:",
        today
    );


    // =================================
    // GET ATTENDANCE TABLE
    // =================================

    try {

        const {
            data: attendance,
            error
        } =
            await supabaseClient
                .from("attendance")
                .select("*")
                .eq("date", today);


        // =================================
        // ERROR
        // =================================

        if (error) {

            console.error(
                "❌ Attendance Query Error:",
                error
            );

            updateTodayAttendanceUI(
                0,
                0,
                0
            );

            return;

        }


        console.log(
            "📊 Today's Attendance:",
            attendance
        );


        // =================================
        // NO DATA
        // =================================

        if (
            !attendance ||
            attendance.length === 0
        ) {

            console.log(
                "ℹ️ No attendance recorded today."
            );

            updateTodayAttendanceUI(
                0,
                0,
                0
            );

            return;

        }


        // =================================
        // COUNT PRESENT
        // =================================

        let present = 0;

        let absent = 0;


        attendance.forEach(function(record) {

            const status =
                String(
                    record.status || ""
                ).toLowerCase();


            if (
                status === "present"
            ) {

                present++;

            }


            else if (
                status === "absent"
            ) {

                absent++;

            }

        });


        // =================================
        // TOTAL
        // =================================

        const total =
            present + absent;


        // =================================
        // ATTENDANCE RATE
        // =================================

        let rate = 0;


        if (total > 0) {

            rate =
                Math.round(
                    (present / total) * 100
                );

        }


        console.log(
            "✅ Present:",
            present
        );

        console.log(
            "❌ Absent:",
            absent
        );

        console.log(
            "📈 Rate:",
            rate + "%"
        );


        // =================================
        // UPDATE DASHBOARD
        // =================================

        updateTodayAttendanceUI(
            present,
            absent,
            rate
        );


    }
    catch (error) {

        console.error(
            "❌ Unexpected Attendance Error:",
            error
        );

    }

}


// =====================================
// UPDATE ATTENDANCE UI
// =====================================

function updateTodayAttendanceUI(
    present,
    absent,
    rate
) {


    // =================================
    // PRESENT
    // =================================

    const presentBox =
        document.getElementById(
            "presentStudents"
        );


    if (presentBox) {

        presentBox.innerText =
            present;

    }


    // =================================
    // ABSENT
    // =================================

    const absentBox =
        document.getElementById(
            "absentStudents"
        );


    if (absentBox) {

        absentBox.innerText =
            absent;

    }


    // =================================
    // ATTENDANCE RATE
    // =================================

    const rateBox =
        document.getElementById(
            "attendanceRate"
        );


    if (rateBox) {

        rateBox.innerText =
            rate + "%";

    }


    // =================================
    // AI SCHOOL REPORT
    // =================================

    const reportPresent =
        document.getElementById(
            "reportPresent"
        );


    if (reportPresent) {

        reportPresent.innerText =
            present;

    }


    const reportAbsent =
        document.getElementById(
            "reportAbsent"
        );


    if (reportAbsent) {

        reportAbsent.innerText =
            absent;

    }


    const reportRate =
        document.getElementById(
            "reportRate"
        );


    if (reportRate) {

        reportRate.innerText =
            rate + "%";

    }

}


// =====================================
// START PART 9
// =====================================

document.addEventListener(
    "DOMContentLoaded",
    function () {

        loadTodayAttendance();

    }
);
