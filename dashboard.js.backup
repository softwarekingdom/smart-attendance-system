// =====================================
// RECENT ATTENDANCE ACTIVITY
// =====================================

async function loadRecentAttendance() {

    const box =
        document.getElementById(
            "recentActivity"
        );


    if (!box) {

        return;

    }


    if (!checkSupabase()) {

        box.innerHTML =
            "<li>Supabase connection error.</li>";

        return;

    }


    try {

        // =================================
        // GET RECENT ATTENDANCE
        // =================================

        const {
            data: attendance,
            error
        } =
            await supabaseClient
                .from("attendance")
                .select("*")
                .order(
                    "date",
                    {
                        ascending: false
                    }
                )
                .limit(10);


        if (error) {

            console.error(
                "Recent Attendance Error:",
                error
            );

            box.innerHTML =
                "<li>Unable to load activity.</li>";

            return;

        }


        const records =
            attendance || [];


        if (records.length === 0) {

            box.innerHTML =
                "<li>No Recent Activity</li>";

            return;

        }


        // =================================
        // GET STUDENTS
        // =================================

        const {
            data: students,
            error: studentError
        } =
            await supabaseClient
                .from("students")
                .select(
                    "id,name"
                );


        if (studentError) {

            console.error(
                "Student Activity Error:",
                studentError
            );

        }


        const studentList =
            students || [];


        // =================================
        // CREATE ACTIVITY
        // =================================

        box.innerHTML = "";


        records.forEach(
            function (record) {

                const studentId =
                    record.student_id ||
                    record.studentId;


                const student =
                    studentList.find(
                        function (item) {

                            return String(
                                item.id
                            ) === String(
                                studentId
                            );

                        }
                    );


                const studentName =
                    student
                        ? student.name
                        : "Student";


                const status =
                    String(
                        record.status || ""
                    )
                    .trim();


                let icon =
                    "📝";


                if (
                    status.toLowerCase()
                    === "present"
                ) {

                    icon = "✅";

                }

                else if (
                    status.toLowerCase()
                    === "absent"
                ) {

                    icon = "❌";

                }


                const li =
                    document.createElement(
                        "li"
                    );


                li.innerHTML = `

                    ${icon}
                    <strong>
                        ${escapeHTML(studentName)}
                    </strong>

                    -
                    ${escapeHTML(status)}

                    <small>
                        ${escapeHTML(
                            record.date || ""
                        )}
                    </small>

                `;


                box.appendChild(li);

            }
        );


    }

    catch (error) {

        console.error(
            "Unexpected Recent Activity Error:",
            error
        );


        box.innerHTML =
            "<li>Unable to load activity.</li>";

    }

}


// =====================================
// AI TREND ANALYSIS
// =====================================

async function loadAITrend() {

    const box =
        document.getElementById(
            "aiTrend"
        );


    if (!box) {

        return;

    }


    if (!checkSupabase()) {

        box.innerHTML =
            "❌ Supabase connection error.";

        return;

    }


    try {

        // =================================
        // GET ATTENDANCE DATA
        // =================================

        const {
            data: attendance,
            error
        } =
            await supabaseClient
                .from("attendance")
                .select("*");


        if (error) {

            console.error(
                "AI Trend Error:",
                error
            );

            box.innerHTML =
                "❌ Unable to analyse attendance.";

            return;

        }


        const records =
            attendance || [];


        if (records.length === 0) {

            box.innerHTML =
                "<p>📊 No attendance data available yet.</p>";

            return;

        }


        // =================================
        // PRESENT / TOTAL
        // =================================

        let present = 0;


        records.forEach(
            function (record) {

                if (
                    String(
                        record.status || ""
                    )
                    .toLowerCase()
                    .trim()
                    === "present"
                ) {

                    present++;

                }

            }
        );


        const total =
            records.length;


        const percentage =
            Math.round(
                (
                    present /
                    total
                ) * 100
            );


        // =================================
        // AI MESSAGE
        // =================================

        let message = "";


        if (
            percentage >= 90
        ) {

            message =
                "🌟 Attendance trend is excellent. Students are maintaining a very good attendance level.";

        }

        else if (
            percentage >= 75
        ) {

            message =
                "👍 Attendance trend is stable. A few students may need monitoring.";

        }

        else if (
            percentage >= 50
        ) {

            message =
                "⚠️ Attendance trend needs attention. Consider contacting frequently absent students.";

        }

        else {

            message =
                "🚨 Attendance trend is very low. Immediate action is recommended.";

        }


        // =================================
        // DISPLAY
        // =================================

        box.innerHTML = `

            <h3>
                📊 Current Attendance Trend:
                ${percentage}%
            </h3>

            <p>
                ${message}
            </p>

            <p>
                📚 Attendance Records:
                <strong>
                    ${total}
                </strong>
            </p>

        `;


    }

    catch (error) {

        console.error(
            "Unexpected AI Trend Error:",
            error
        );


        box.innerHTML =
            "❌ Unable to load AI trend.";

    }

}


// =====================================
// AUTO REFRESH
// =====================================

setInterval(
    function () {

        loadRecentAttendance();

        loadAITrend();

    },
    30000
);
