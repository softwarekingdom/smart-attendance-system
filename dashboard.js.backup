// PART 4
// Attendance Charts
// Supabase Version
// =====================================


// =====================================
// CHART VARIABLES
// =====================================

let attendanceLineChart = null;
let attendancePieChart = null;


// =====================================
// PAGE LOAD
// =====================================

document.addEventListener(
    "DOMContentLoaded",
    function () {

        loadAttendanceCharts();

    }
);


// =====================================
// LOAD ATTENDANCE CHARTS
// =====================================

async function loadAttendanceCharts() {

    if (!checkSupabase()) {

        return;

    }


    try {

        // =================================
        // GET ATTENDANCE DATA
        // =================================

        const {
            data: attendance,
            error
        } =
            await supabaseClient
                .from("attendance")
                .select("*");


        if (error) {

            console.error(
                "Chart Attendance Error:",
                error
            );

            return;

        }


        const records =
            attendance || [];


        // =================================
        // CREATE WEEK DATA
        // =================================

        const days = [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday"
        ];


        const presentData = [
            0,
            0,
            0,
            0,
            0
        ];


        const absentData = [
            0,
            0,
            0,
            0,
            0
        ];


        // =================================
        // PROCESS ATTENDANCE
        // =================================

        records.forEach(
            function (record) {

                if (!record.date) {

                    return;

                }


                const date =
                    new Date(
                        record.date
                    );


                if (
                    isNaN(
                        date.getTime()
                    )
                ) {

                    return;

                }


                const day =
                    date.getDay();


                // Sunday = 0
                // Monday = 1
                // Friday = 5

                if (
                    day < 1 ||
                    day > 5
                ) {

                    return;

                }


                const index =
                    day - 1;


                const status =
                    String(
                        record.status || ""
                    )
                    .toLowerCase()
                    .trim();


                if (
                    status === "present"
                ) {

                    presentData[index]++;

                }


                else if (
                    status === "absent"
                ) {

                    absentData[index]++;

                }

            }
        );


        // =================================
        // LINE CHART
        // =================================

        createAttendanceLineChart(
            days,
            presentData
        );


        // =================================
        // PIE CHART
        // =================================

        createAttendancePieChart(
            presentData,
            absentData
        );


        console.log(
            "📊 Attendance Charts Loaded"
        );

    }

    catch (error) {

        console.error(
            "Unexpected Chart Error:",
            error
        );

    }

}


// =====================================
// CREATE LINE CHART
// =====================================

function createAttendanceLineChart(
    labels,
    data
) {

    const canvas =
        document.getElementById(
            "attendanceLineChart"
        );


    if (!canvas) {

        console.warn(
            "❌ attendanceLineChart not found."
        );

        return;

    }


    // =================================
    // DESTROY OLD CHART
    // =================================

    if (attendanceLineChart) {

        attendanceLineChart.destroy();

    }


    // =================================
    // CREATE NEW CHART
    // =================================

    attendanceLineChart =
        new Chart(
            canvas,
            {

                type: "line",

                data: {

                    labels: labels,

                    datasets: [

                        {

                            label:
                                "Present Students",

                            data: data,

                            borderWidth: 3,

                            tension: 0.4,

                            fill: false

                        }

                    ]

                },


                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    plugins: {

                        legend: {

                            display: true

                        }

                    },


                    scales: {

                        y: {

                            beginAtZero: true,

                            ticks: {

                                precision: 0

                            }

                        }

                    }

                }

            }
        );

}


// =====================================
// CREATE PIE CHART
// =====================================

function createAttendancePieChart(
    presentData,
    absentData
) {

    const canvas =
        document.getElementById(
            "attendancePieChart"
        );


    if (!canvas) {

        console.warn(
            "❌ attendancePieChart not found."
        );

        return;

    }


    // =================================
    // TOTAL PRESENT
    // =================================

    const present =
        presentData.reduce(
            function (
                total,
                value
            ) {

                return total + value;

            },
            0
        );


    // =================================
    // TOTAL ABSENT
    // =================================

    const absent =
        absentData.reduce(
            function (
                total,
                value
            ) {

                return total + value;

            },
            0
        );


    // =================================
    // DESTROY OLD CHART
    // =================================

    if (attendancePieChart) {

        attendancePieChart.destroy();

    }


    // =================================
    // CREATE PIE CHART
    // =================================

    attendancePieChart =
        new Chart(
            canvas,
            {

                type: "pie",

                data: {

                    labels: [

                        "Present",

                        "Absent"

                    ],

                    datasets: [

                        {

                            data: [

                                present,

                                absent

                            ],

                            borderWidth: 1

                        }

                    ]

                },


                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    plugins: {

                        legend: {

                            display: true,

                            position: "bottom"

                        }

                    }

                }

            }
        );

}


// =====================================
// AUTO REFRESH CHARTS
// =====================================

setInterval(
    function () {

        loadAttendanceCharts();

    },
    30000
);
