// =====================================
// LOAD ATTENDANCE RANKING
// =====================================

async function loadAttendanceRanking() {

    const topBox =
        document.getElementById(
            "topStudents"
        );

    const lowBox =
        document.getElementById(
            "lowStudents"
        );


    if (
        !topBox &&
        !lowBox
    ) {

        return;

    }


    if (!checkSupabase()) {

        if (topBox) {
            topBox.innerHTML =
                "❌ Supabase connection error.";
        }

        if (lowBox) {
            lowBox.innerHTML =
                "❌ Supabase connection error.";
        }

        return;

    }


    try {

        // =================================
        // GET STUDENTS
        // =================================

        const {
            data: students,
            error: studentError
        } =
            await supabaseClient
                .from("students")
                .select("*");


        if (studentError) {

            console.error(
                "Ranking Student Error:",
                studentError
            );

            return;

        }


        const studentList =
            students || [];


        // =================================
        // GET ATTENDANCE
        // =================================

        const {
            data: attendance,
            error: attendanceError
        } =
            await supabaseClient
                .from("attendance")
                .select("*");


        if (attendanceError) {

            console.error(
                "Ranking Attendance Error:",
                attendanceError
            );

            return;

        }


        const attendanceList =
            attendance || [];


        // =================================
        // NO STUDENTS
        // =================================

        if (
            studentList.length === 0
        ) {

            if (topBox) {

                topBox.innerHTML =
                    "<p>No students available.</p>";

            }

            if (lowBox) {

                lowBox.innerHTML =
                    "<p>No students available.</p>";

            }

            return;

        }


        // =================================
        // CALCULATE EACH STUDENT
        // =================================

        const reports = [];


        studentList.forEach(
            function (student) {

                const studentId =
                    student.id;


                const records =
                    attendanceList.filter(
                        function (record) {

                            const recordStudentId =
                                record.student_id ||
                                record.studentId;

                            return String(
                                recordStudentId
                            ) === String(
                                studentId
                            );

                        }
                    );


                let present = 0;

                let absent = 0;


                records.forEach(
                    function (record) {

                        const status =
                            String(
                                record.status || ""
                            )
                            .toLowerCase()
                            .trim();


                        if (
                            status === "present"
                        ) {

                            present++;

                        }

                        else if (
                            status === "absent"
                        ) {

                            absent++;

                        }

                    }
                );


                const total =
                    present + absent;


                let rate = 0;


                if (total > 0) {

                    rate =
                        Math.round(
                            (
                                present /
                                total
                            ) * 100
                        );

                }


                reports.push({

                    id:
                        student.id,

                    name:
                        student.name ||
                        "Student",

                    present:
                        present,

                    absent:
                        absent,

                    total:
                        total,

                    rate:
                        rate

                });

            }
        );


        // =================================
        // SORT BY ATTENDANCE RATE
        // =================================

        reports.sort(
            function (a, b) {

                return (
                    b.rate -
                    a.rate
                );

            }
        );


        // =================================
        // TOP 5
        // =================================

        if (topBox) {

            topBox.innerHTML = "";


            const topStudents =
                reports
                    .filter(
                        function (student) {

                            return (
                                student.total > 0
                            );

                        }
                    )
                    .slice(0, 5);


            if (
                topStudents.length === 0
            ) {

                topBox.innerHTML =
                    "<p>No attendance data available.</p>";

            }

            else {

                topStudents.forEach(
                    function (
                        student,
                        index
                    ) {

                        const item =
                            document.createElement(
                                "div"
                            );


                        item.className =
                            "ranking-item";


                        item.innerHTML = `

                            <strong>
                                🏅 ${index + 1}.
                                ${escapeHTML(
                                    student.name
                                )}
                            </strong>

                            <span>
                                ${student.rate}%
                            </span>

                        `;


                        topBox.appendChild(
                            item
                        );

                    }
                );

            }

        }


        // =================================
        // LOW ATTENDANCE
        // =================================

        if (lowBox) {

            lowBox.innerHTML = "";


            const lowStudents =
                reports.filter(
                    function (student) {

                        return (
                            student.total > 0 &&
                            student.rate < 75
                        );

                    }
                );


            if (
                lowStudents.length === 0
            ) {

                lowBox.innerHTML =

                    "<p>🎉 No students with low attendance.</p>";

            }

            else {

                lowStudents.forEach(
                    function (student) {

                        const item =
                            document.createElement(
                                "div"
                            );


                        item.className =
                            "ranking-item low";


                        item.innerHTML = `

                            <strong>
                                ⚠️
                                ${escapeHTML(
                                    student.name
                                )}
                            </strong>

                            <span>
                                ${student.rate}%
                            </span>

                        `;


                        lowBox.appendChild(
                            item
                        );

                    }
                );

            }

        }


        console.log(
            "🏆 Attendance Ranking Loaded"
        );

    }

    catch (error) {

        console.error(
            "Unexpected Ranking Error:",
            error
        );


        if (topBox) {

            topBox.innerHTML =
                "<p>❌ Unable to load ranking.</p>";

        }


        if (lowBox) {

            lowBox.innerHTML =
                "<p>❌ Unable to load ranking.</p>";

        }

    }

}


// =====================================
// AUTO REFRESH
// =====================================

setInterval(
    function () {

        loadAttendanceRanking();

    },
    30000
);
