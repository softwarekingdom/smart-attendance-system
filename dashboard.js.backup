// AI SCHOOL
// Dashboard System
// PART 7
// Weekly Attendance Analysis
// Supabase Version
// =====================================


// =====================================
// PAGE LOAD
// =====================================

document.addEventListener(
    "DOMContentLoaded",
    function () {

        loadWeeklyAttendance();

    }
);


// =====================================
// LOAD WEEKLY ATTENDANCE
// =====================================

async function loadWeeklyAttendance() {

    const box =
        document.getElementById(
            "weeklyAttendance"
        );


    if (!box) {

        return;

    }


    if (!checkSupabase()) {

        box.innerHTML =
            "<p>❌ Supabase connection error.</p>";

        return;

    }


    try {

        // =================================
        // GET ATTENDANCE
        // =================================

        const {
            data: attendance,
            error
        } =
            await supabaseClient
                .from("attendance")
                .select("*");


        if (error) {

            console.error(
                "Weekly Attendance Error:",
                error
            );

            box.innerHTML =
                "<p>❌ Unable to load attendance.</p>";

            return;

        }


        const records =
            attendance || [];


        // =================================
        // DAYS
        // =================================

        const days = [

            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday"

        ];


        // =================================
        // CREATE DATA
        // =================================

        const weeklyData = {

            Monday: {
                present: 0,
                absent: 0
            },

            Tuesday: {
                present: 0,
                absent: 0
            },

            Wednesday: {
                present: 0,
                absent: 0
            },

            Thursday: {
                present: 0,
                absent: 0
            },

            Friday: {
                present: 0,
                absent: 0
            }

        };


        // =================================
        // PROCESS RECORDS
        // =================================

        records.forEach(
            function (record) {

                if (!record.date) {

                    return;

                }


                const date =
                    new Date(
                        record.date
                    );


                if (
                    isNaN(
                        date.getTime()
                    )
                ) {

                    return;

                }


                const dayIndex =
                    date.getDay();


                // Sunday = 0
                // Monday = 1
                // Friday = 5

                if (
                    dayIndex < 1 ||
                    dayIndex > 5
                ) {

                    return;

                }


                const dayName =
                    days[
                        dayIndex - 1
                    ];


                const status =
                    String(
                        record.status || ""
                    )
                    .toLowerCase()
                    .trim();


                if (
                    status === "present"
                ) {

                    weeklyData[
                        dayName
                    ].present++;

                }

                else if (
                    status === "absent"
                ) {

                    weeklyData[
                        dayName
                    ].absent++;

                }

            }
        );


        // =================================
        // BUILD HTML
        // =================================

        let output = "";


        days.forEach(
            function (day) {

                const present =
                    weeklyData[
                        day
                    ].present;


                const absent =
                    weeklyData[
                        day
                    ].absent;


                const total =
                    present +
                    absent;


                let percentage = 0;


                if (total > 0) {

                    percentage =
                        Math.round(
                            (
                                present /
                                total
                            ) * 100
                        );

                }


                output += `

                    <div class="weekly-row">

                        <div class="weekly-day">

                            <strong>
                                ${day}
                            </strong>

                        </div>


                        <div class="weekly-progress">

                            <div
                                class="weekly-progress-fill"
                                style="
                                    width:${percentage}%;
                                "
                            ></div>

                        </div>


                        <div class="weekly-percent">

                            <strong>
                                ${percentage}%
                            </strong>

                        </div>

                    </div>

                `;

            }
        );


        // =================================
        // DISPLAY
        // =================================

        box.innerHTML =
            output;


        console.log(
            "📊 Weekly Attendance Loaded"
        );

    }

    catch (error) {

        console.error(
            "Unexpected Weekly Attendance Error:",
            error
        );


        box.innerHTML =
            "<p>❌ Unable to load weekly attendance.</p>";

    }

}


// =====================================
// AUTO REFRESH
// =====================================

setInterval(
    function () {

        loadWeeklyAttendance();

    },
    30000
);
