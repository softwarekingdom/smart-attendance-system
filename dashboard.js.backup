// =====================================
// LOAD AI PREDICTION
// =====================================

async function loadAIPrediction() {

    const predictionBox =
        document.getElementById(
            "prediction"
        );

    const aiPredictionBox =
        document.getElementById(
            "aiPrediction"
        );

    const expectedBox =
        document.getElementById(
            "expectedAttendance"
        );

    const riskBox =
        document.getElementById(
            "riskCount"
        );

    const recommendationBox =
        document.getElementById(
            "aiRecommendation"
        );

    const riskStudentsBox =
        document.getElementById(
            "riskStudents"
        );


    // =================================
    // CHECK SUPABASE
    // =================================

    if (!checkSupabase()) {

        return;

    }


    // =================================
    // GET TODAY
    // =================================

    const today =
        new Date();

    const year =
        today.getFullYear();

    const month =
        String(
            today.getMonth() + 1
        ).padStart(
            2,
            "0"
        );

    const day =
        String(
            today.getDate()
        ).padStart(
            2,
            "0"
        );

    const todayDate =
        `${year}-${month}-${day}`;


    try {

        // =================================
        // GET STUDENTS
        // =================================

        const {
            data: students,
            error: studentError
        } =
            await supabaseClient
                .from("students")
                .select("*");


        if (studentError) {

            console.error(
                "AI Student Error:",
                studentError
            );

            return;

        }


        const studentList =
            students || [];


        // =================================
        // GET TODAY ATTENDANCE
        // =================================
console.log("🔥 STEP 1 - Query starting");

const result =
    await supabaseClient
        .from("attendance")
        .select("*")
        .eq(
            "attendance_date",
            todayDate
        );

console.log("🔥 STEP 2 - Query finished");

console.log(
    "🔥 ATTENDANCE RESULT:",
    result
);

const attendanceList =
    result.data || [];

const attendanceError =
    result.error;

console.log(
    "🔥 ATTENDANCE DATA:",
    attendanceList
);

console.log(
    "🔥 ATTENDANCE ERROR:",
    attendanceError
);
        // =================================
        // COUNT PRESENT
        // =================================

        let present = 0;

        let absent = 0;


        attendanceList.forEach(
            function (record) {

                const status =
                    String(
                        record.status || ""
                    )
                    .toLowerCase()
                    .trim();


                if (
                    status === "present"
                ) {

                    present++;

                }


                if (
                    status === "absent"
                ) {

                    absent++;

                }

            }
        );


        // =================================
        // EXPECTED ATTENDANCE
        // =================================

        let expected = 0;


        if (
            studentList.length > 0
        ) {

            expected =
                Math.round(
                    (
                        present /
                        studentList.length
                    ) * 100
                );

        }


        // =================================
        // FIND RISK STUDENTS
        // =================================

        const riskStudents = [];


        attendanceList.forEach(
            function (record) {

                const status =
                    String(
                        record.status || ""
                    )
                    .toLowerCase()
                    .trim();


                if (
                    status !== "absent"
                ) {

                    return;

                }


                const studentId =
                    record.student_id ||
                    record.studentId;


                const student =
                    studentList.find(
                        function (item) {

                            return String(
                                item.id
                            ) === String(
                                studentId
                            );

                        }
                    );


                if (student) {

                    riskStudents.push(
                        student
                    );

                }

            }
        );


        // =================================
        // AI RECOMMENDATION
        // =================================

        let recommendation = "";


        if (expected >= 90) {

            recommendation =
                "🌟 Excellent attendance. Keep maintaining this level.";

        }

        else if (expected >= 75) {

            recommendation =
                "👍 Good attendance. Monitor students who were absent today.";

        }

        else if (expected > 0) {

            recommendation =
                "⚠️ Attendance is low. Contact absent students and their parents.";

        }

        else {

            recommendation =
                "📊 Not enough attendance data for prediction.";

        }


        // =================================
        // UPDATE PREDICTION BOX
        // =================================

        if (predictionBox) {

            predictionBox.innerHTML = `

                📈 Expected Attendance Tomorrow:
                <strong>
                    ${expected}%
                </strong>

                <br><br>

                ⚠️ Students At Risk:
                <strong>
                    ${riskStudents.length}
                </strong>

                <br><br>

                💡 Recommendation:
                <br>
                ${recommendation}

            `;

        }


        // =================================
        // UPDATE AI PREDICTION CARD
        // =================================

        if (aiPredictionBox) {

            aiPredictionBox.innerHTML =

                "🤖 AI predicts " +
                expected +
                "% attendance tomorrow.";

        }


        // =================================
        // EXPECTED ATTENDANCE
        // =================================

        if (expectedBox) {

            expectedBox.innerText =
                expected + "%";

        }


        // =================================
        // RISK COUNT
        // =================================

        if (riskBox) {

            riskBox.innerText =
                riskStudents.length;

        }


        // =================================
        // RECOMMENDATION
        // =================================

        if (recommendationBox) {

            recommendationBox.innerText =
                recommendation;

        }


        // =================================
        // SCHOOL REPORT RISK
        // =================================

        if (riskStudentsBox) {

            riskStudentsBox.innerText =
                riskStudents.length;

        }


        console.log(
            "🤖 AI Prediction:",
            expected + "%"
        );


        console.log(
            "⚠️ Risk Students:",
            riskStudents.length
        );


    }

    catch (error) {

        console.error(
            "Unexpected AI Prediction Error:",
            error
        );

    }

}


