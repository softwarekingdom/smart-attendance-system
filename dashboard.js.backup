document.addEventListener(
    "DOMContentLoaded",
    function () {

        loadAISchoolSummary();

    }
);


// =====================================
// LOAD AI SCHOOL SUMMARY
// =====================================

async function loadAISchoolSummary() {

    const summaryBox =
        document.getElementById(
            "aiSummary"
        );

    const bestClassBox =
        document.getElementById(
            "bestClass"
        );

    const riskBox =
        document.getElementById(
            "riskStudents"
        );


    if (!checkSupabase()) {

        return;

    }


    try {

        // =================================
        // GET STUDENTS
        // =================================

        const {
            data: students,
            error: studentError
        } =
            await supabaseClient
                .from("students")
                .select("*");


        if (studentError) {

            console.error(
                "AI Summary Student Error:",
                studentError
            );

            return;

        }


        const studentList =
            students || [];


        // =================================
        // GET ATTENDANCE
        // =================================

        const {
            data: attendance,
            error: attendanceError
        } =
            await supabaseClient
                .from("attendance")
                .select("*");


        if (attendanceError) {

            console.error(
                "AI Summary Attendance Error:",
                attendanceError
            );

            return;

        }


        const attendanceList =
            attendance || [];


        // =================================
        // TOTAL STUDENTS
        // =================================

        const totalStudents =
            studentList.length;


        // =================================
        // TODAY DATE
        // =================================

        const today =
            new Date();

        const todayString =
            today.toISOString()
                .split("T")[0];


        // =================================
        // TODAY ATTENDANCE
        // =================================

        const todayAttendance =
            attendanceList.filter(
                function (record) {

                    return String(
                        record.date || ""
                    ).startsWith(
                        todayString
                    );

                }
            );


        let presentToday = 0;

        let absentToday = 0;


        todayAttendance.forEach(
            function (record) {

                const status =
                    String(
                        record.status || ""
                    )
                    .toLowerCase()
                    .trim();


                if (
                    status === "present"
                ) {

                    presentToday++;

                }


                else if (
                    status === "absent"
                ) {

                    absentToday++;

                }

            }
        );


        // =================================
        // ATTENDANCE RATE
        // =================================

        let attendanceRate = 0;


        if (
            totalStudents > 0
        ) {

            attendanceRate =
                Math.round(
                    (
                        presentToday /
                        totalStudents
                    ) * 100
                );

        }


        // =================================
        // RISK STUDENTS
        // =================================

        const riskStudents = [];


        studentList.forEach(
            function (student) {

                const records =
                    attendanceList.filter(
                        function (record) {

                            const id =
                                record.student_id ||
                                record.studentId;


                            return String(id)
                                === String(
                                    student.id
                                );

                        }
                    );


                let present = 0;

                let total = 0;


                records.forEach(
                    function (record) {

                        const status =
                            String(
                                record.status || ""
                            )
                            .toLowerCase()
                            .trim();


                        if (
                            status === "present" ||
                            status === "absent"
                        ) {

                            total++;

                        }


                        if (
                            status === "present"
                        ) {

                            present++;

                        }

                    }
                );


                if (
                    total > 0
                ) {

                    const rate =
                        Math.round(
                            (
                                present /
                                total
                            ) * 100
                        );


                    if (
                        rate < 75
                    ) {

                        riskStudents.push({
                            name:
                                student.name ||
                                "Student",

                            rate:
                                rate

                        });

                    }

                }

            }
        );


        // =================================
        // BEST CLASS
        // =================================

        const classStats = {};


        studentList.forEach(
            function (student) {

                const className =
                    student.class_name ||
                    student.className ||
                    "Unknown";


                if (
                    !classStats[
                        className
                    ]
                ) {

                    classStats[
                        className
                    ] = {

                        present: 0,

                        total: 0

                    };

                }


                const records =
                    attendanceList.filter(
                        function (record) {

                            const id =
                                record.student_id ||
                                record.studentId;


                            return String(id)
                                === String(
                                    student.id
                                );

                        }
                    );


                records.forEach(
                    function (record) {

                        const status =
                            String(
                                record.status || ""
                            )
                            .toLowerCase()
                            .trim();


                        if (
                            status === "present" ||
                            status === "absent"
                        ) {

                            classStats[
                                className
                            ].total++;

                        }


                        if (
                            status === "present"
                        ) {

                            classStats[
                                className
                            ].present++;

                        }

                    }
                );

            }
        );


        let bestClass =
            "No Data";

        let bestRate = -1;


        Object.keys(
            classStats
        ).forEach(
            function (className) {

                const stats =
                    classStats[
                        className
                    ];


                if (
                    stats.total === 0
                ) {

                    return;

                }


                const rate =
                    Math.round(
                        (
                            stats.present /
                            stats.total
                        ) * 100
                    );


                if (
                    rate > bestRate
                ) {

                    bestRate =
                        rate;

                    bestClass =
                        className +
                        " (" +
                        rate +
                        "%)";

                }

            }
        );


        // =================================
        // UPDATE BEST CLASS
        // =================================

        if (bestClassBox) {

            bestClassBox.innerText =
                bestClass;

        }


        // =================================
        // UPDATE RISK COUNT
        // =================================

        if (riskBox) {

            riskBox.innerText =
                riskStudents.length;

        }


        // =================================
        // AI SUMMARY MESSAGE
        // =================================

        let message = "";


        if (
            attendanceRate >= 90
        ) {

            message =
                "🌟 Excellent attendance today. The school is maintaining a very strong attendance level.";

        }

        else if (
            attendanceRate >= 75
        ) {

            message =
                "👍 Attendance is good today. A few students may require monitoring.";

        }

        else if (
            attendanceRate > 0
        ) {

            message =
                "⚠️ Attendance is below the expected level. Teachers should follow up with absent students.";

        }

        else {

            message =
                "📊 Attendance data is not available for today yet.";

        }


        // =================================
        // DISPLAY AI SUMMARY
        // =================================

        if (summaryBox) {

            summaryBox.innerText =

                "AI SCHOOL ANALYSIS\n\n" +

                "👨‍🎓 Total Students : " +
                totalStudents +

                "\n\n" +

                "✅ Present Today : " +
                presentToday +

                "\n\n" +

                "❌ Absent Today : " +
                absentToday +

                "\n\n" +

                "📈 Attendance Rate : " +
                attendanceRate +
                "%\n\n" +

                "🏆 Best Class : " +
                bestClass +

                "\n\n" +

                "⚠️ Students At Risk : " +
                riskStudents.length +

                "\n\n" +

                "🤖 AI Recommendation\n" +
                message;

        }


        console.log(
            "🤖 AI School Summary Loaded"
        );


    }

    catch (error) {

        console.error(
            "Unexpected AI Summary Error:",
            error
        );


    }

}


// =====================================
// AUTO REFRESH
// =====================================

setInterval(
    function () {

        loadAISchoolSummary();

    },
    30000
);
