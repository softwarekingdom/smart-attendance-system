// =====================================
// PAGE LOAD
// =====================================

document.addEventListener(
    "DOMContentLoaded",
    function () {

        loadTeacherInfo();

        showDate();

        loadAssignedClass();

        loadStudentCount();

        loadTodayAttendance();

      loadAttendanceAnalytics();

    }
);


// =====================================
// CHECK SUPABASE
// =====================================

function checkSupabase() {

    if (
        typeof supabaseClient ===
        "undefined"
    ) {

        console.error(
            "❌ supabaseClient is not defined."
        );

        return false;

    }

    return true;

}


// =====================================
// LOAD TEACHER INFORMATION
// =====================================

function loadTeacherInfo() {

    const teacherData =
        localStorage.getItem(
            "currentUser"
        );


    if (!teacherData) {

        console.warn(
            "❌ No logged-in teacher found."
        );

        return;

    }


    let teacher;


    try {

        teacher =
            JSON.parse(
                teacherData
            );

    }

    catch (error) {

        console.error(
            "Teacher Data Error:",
            error
        );

        return;

    }


    const nameBox =
        document.getElementById(
            "welcomeTeacher"
        );


    if (nameBox) {

        nameBox.innerText =
            "Welcome " +
            (teacher.name || "Teacher") +
            " 👨‍🏫";

    }


    const roleBox =
        document.getElementById(
            "teacherRole"
        );


    if (roleBox) {

        roleBox.innerText =
            "Role : " +
            (teacher.role || "Teacher");

    }

}


// =====================================
// SHOW CURRENT DATE
// =====================================

function showDate() {

    const dateBox =
        document.getElementById(
            "currentDate"
        );


    if (!dateBox) {

        return;

    }


    const today =
        new Date();


    dateBox.innerText =
        "📅 " +
        today.toDateString();

}


// =====================================
// LOAD ASSIGNED CLASSES
// =====================================

async function loadAssignedClass() {

    const box =
        document.getElementById(
            "assignedClass"
        );


    if (!box) {

        console.error(
            "❌ assignedClass element not found."
        );

        return;

    }


    box.innerHTML =
        "Loading...";


    if (!checkSupabase()) {

        box.innerHTML =
            "❌ Supabase Connection Error";

        return;

    }


    const currentUserData =
        localStorage.getItem(
            "currentUser"
        );


    if (!currentUserData) {

        box.innerHTML =
            "❌ No Logged In Teacher";

        return;

    }


    let currentUser;


    try {

        currentUser =
            JSON.parse(
                currentUserData
            );

    }

    catch (error) {

        console.error(
            "Current User Error:",
            error
        );

        box.innerHTML =
            "❌ Invalid Teacher Data";

        return;

    }


    const username =
        currentUser.username;


    if (!username) {

        box.innerHTML =
            "❌ Username Not Found";

        return;

    }


    try {

        const {
            data: teacher,
            error
        } =
            await supabaseClient
                .from("teachers")
                .select(
                    "id,name,username,classes"
                )
                .eq(
                    "username",
                    username
                )
                .maybeSingle();


        if (error) {

            console.error(
                "Assigned Class Error:",
                error
            );

            box.innerHTML =
                "❌ Unable to load classes";

            return;

        }


        if (!teacher) {

            box.innerHTML =
                "❌ Teacher Not Found";

            return;

        }


        const classes =
            Array.isArray(
                teacher.classes
            )
                ? teacher.classes
                : [];


        if (
            classes.length === 0
        ) {

            box.innerHTML =
                "No Assigned Class";

            return;

        }


        box.innerHTML =
            classes
                .map(
                    function (className) {

                        return (
                            "🏫 " +
                            escapeHTML(
                                className
                            )
                        );

                    }
                )
                .join("<br>");


        currentUser.classes =
            classes;


        localStorage.setItem(
            "currentUser",
            JSON.stringify(
                currentUser
            )
        );

    }

    catch (error) {

        console.error(
            "Unexpected Class Error:",
            error
        );

        box.innerHTML =
            "❌ Unable to load classes";

    }

}


// =====================================
// LOAD TOTAL STUDENT COUNT
// =====================================

async function loadStudentCount() {

    const countBox =
        document.getElementById(
            "totalStudents"
        );


    const reportBox =
        document.getElementById(
            "reportStudents"
        );


    if (!checkSupabase()) {

        return;

    }


    try {

        const {
            count,
            error
        } =
            await supabaseClient
                .from("students")
                .select(
                    "*",
                    {
                        count: "exact",
                        head: true
                    }
                );


        if (error) {

            console.error(
                "Student Count Error:",
                error
            );

            return;

        }


        const total =
            count || 0;


        if (countBox) {

            countBox.innerText =
                total;

        }


        if (reportBox) {

            reportBox.innerText =
                total;

        }

    }

    catch (error) {

        console.error(
            "Unexpected Student Count Error:",
            error
        );

    }

}


// =====================================
// PART 2
// TODAY'S ATTENDANCE ANALYTICS
// =====================================
// =====================================
// TODAY'S ATTENDANCE
// Supabase Version
// =====================================

async function loadTodayAttendance() {

    const presentBox =
        document.getElementById("presentStudents");

    const absentBox =
        document.getElementById("absentStudents");

    const rateBox =
        document.getElementById("attendanceRate");

    const reportPresent =
        document.getElementById("reportPresent");

    const reportAbsent =
        document.getElementById("reportAbsent");

    const reportRate =
        document.getElementById("reportRate");


    // =================================
    // DEFAULT
    // =================================

    if (presentBox) presentBox.innerText = "0";
    if (absentBox) absentBox.innerText = "0";
    if (rateBox) rateBox.innerText = "0%";

    if (reportPresent) reportPresent.innerText = "0";
    if (reportAbsent) reportAbsent.innerText = "0";
    if (reportRate) reportRate.innerText = "0%";


    // =================================
    // CHECK SUPABASE
    // =================================

    if (!checkSupabase()) {
        return;
    }


    // =================================
    // TODAY DATE
    // =================================

    const today = new Date();

    const year =
        today.getFullYear();

    const month =
        String(today.getMonth() + 1)
        .padStart(2, "0");

    const day =
        String(today.getDate())
        .padStart(2, "0");

    const todayDate =
        `${year}-${month}-${day}`;


    console.log(
        "📅 Dashboard Attendance Date:",
        todayDate
    );


    try {

        // =================================
        // GET TODAY'S ATTENDANCE
        // =================================

        const {
            data: attendance,
            error: attendanceError
        } =
            await supabaseClient
                .from("attendance")
                .select("*")
                .eq(
                    "attendance_date",
                    todayDate
                );


        if (attendanceError) {

            console.error(
                "❌ Attendance Error:",
                attendanceError
            );

            return;
        }


        const records =
            attendance || [];


        console.log(
            "📋 Today's Attendance:",
            records
        );


        // =================================
        // COUNT
        // =================================

        let present = 0;
        let absent = 0;


        records.forEach(
            function(record) {

                const status =
                    String(
                        record.status || ""
                    )
                    .toLowerCase()
                    .trim();


                if (status === "present") {

                    present++;

                }


                if (status === "absent") {

                    absent++;

                }

            }
        );


        // =================================
        // GET TOTAL STUDENTS
        // =================================

        const {
            count: totalStudents,
            error: studentError
        } =
            await supabaseClient
                .from("students")
                .select(
                    "*",
                    {
                        count: "exact",
                        head: true
                    }
                );


        if (studentError) {

            console.error(
                "❌ Student Count Error:",
                studentError
            );

            return;
        }


        const total =
            totalStudents || 0;


        // =================================
        // ATTENDANCE RATE
        // =================================

        let rate = 0;


        if (total > 0) {

            rate =
                Math.round(
                    (present / total) * 100
                );

        }


        // =================================
        // UPDATE DASHBOARD
        // =================================

        if (presentBox) {

            presentBox.innerText =
                present;

        }


        if (absentBox) {

            absentBox.innerText =
                absent;

        }


        if (rateBox) {

            rateBox.innerText =
                rate + "%";

        }


        // =================================
        // UPDATE AI REPORT
        // =================================

        if (reportPresent) {

            reportPresent.innerText =
                present;

        }


        if (reportAbsent) {

            reportAbsent.innerText =
                absent;

        }


        if (reportRate) {

            reportRate.innerText =
                rate + "%";

        }


        // =================================
        // DEBUG
        // =================================

        console.log(
            "👨‍🎓 Total Students:",
            total
        );

        console.log(
            "✅ Present Today:",
            present
        );

        console.log(
            "❌ Absent Today:",
            absent
        );

        console.log(
            "📈 Attendance Rate:",
            rate + "%"
        );

    }

    catch (error) {

        console.error(
            "❌ Unexpected Attendance Error:",
            error
        );

    }

}
// =====================================
// HTML SECURITY
// =====================================
function escapeHTML(value) {

    if (
        value === null ||
        value === undefined
    ) {

        return "";

    }


    return String(value)

        .replace(
            /&/g,
            "&amp;"
        )

        .replace(
            /</g,
            "&lt;"
        )

        .replace(
            />/g,
            "&gt;"
        )

        .replace(
            /"/g,
            "&quot;"
        )

        .replace(
            /'/g,
            "&#039;"
        );

}
// =====================================
// AUTO REFRESH
// Every 30 Seconds
// =====================================

setInterval(
    function () {

        loadStudentCount();

        loadTodayAttendance();

        loadAssignedClass();

    },
    30000
);
